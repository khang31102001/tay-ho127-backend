# Copy thành /opt/tayho/.env trên VPS rồi điền giá trị thật. KHÔNG commit file .env thật.
# Phân quyền: chmod 600 /opt/tayho/.env

GHCR_OWNER=khang31102001

# --- Postgres ---
POSTGRES_DB=adminplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-manh

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# Sinh bằng: openssl rand -base64 32
JWT_SIGNING_KEY=
JWT_ISSUER=AdminPlatform
JWT_AUDIENCE=AdminPlatform.Clients

# --- Tài khoản SuperAdmin (Migrator seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=doi-mat-khau-admin
SEED_ADMIN_FULLNAME=Super Admin

# --- OTP / eSMS (module Notification + Integration) ---
# Sinh bằng: openssl rand -base64 32 (base64, tối thiểu 32 byte, KHÔNG dùng lại JWT key).
NOTIFICATION_OTP_HMAC_KEY=
# Để trống đến khi có khoá eSMS; OA id, brandname, template id cấu hình trong Admin -> Tích hợp.
ESMS_API_KEY=
ESMS_SECRET_KEY=

# --- Ảnh upload ---
# Origin công khai, KHÔNG có dấu / cuối. Được ghi vào URL ảnh trong DB lúc upload, nên đặt đúng trước khi upload;
# đổi sang domain sau này thì ảnh cũ vẫn giữ URL cũ.
PUBLIC_BASE_URL=http://IP_VPS

GOOGLE_CLIENT_ID=
