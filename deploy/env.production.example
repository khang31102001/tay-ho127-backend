# Copy thành /opt/tayho/.env trên VPS rồi điền giá trị thật. KHÔNG commit file .env thật.
# Phân quyền: chmod 600 /opt/tayho/.env

GHCR_OWNER=khang31102001

# --- Postgres ---
POSTGRES_DB=adminplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-manh

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# Sinh bằng: openssl rand -base64 32
JWT_SIGNING_KEY=
JWT_ISSUER=AdminPlatform
JWT_AUDIENCE=AdminPlatform.Clients

# --- Tài khoản SuperAdmin (Migrator seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=doi-mat-khau-admin
SEED_ADMIN_FULLNAME=Super Admin

# --- OTP / eSMS (module Notification + Integration) ---
# Sinh bằng: openssl rand -base64 32 (base64, tối thiểu 32 byte, KHÔNG dùng lại JWT key).
NOTIFICATION_OTP_HMAC_KEY=
# Để trống đến khi có khoá eSMS; OA id, brandname, template id cấu hình trong Admin -> Tích hợp.
ESMS_API_KEY=
ESMS_SECRET_KEY=

# --- Ảnh upload ---
# Origin công khai, KHÔNG có dấu / cuối. Được ghi vào URL ảnh trong DB lúc upload, nên đặt đúng trước khi upload;
# đổi sang domain sau này thì ảnh cũ vẫn giữ URL cũ.
PUBLIC_BASE_URL=http://IP_VPS
# Nơi lưu MẶC ĐỊNH khi upload (Admin vẫn chọn được nơi khác): Local = disk VPS; Cloudinary = cần đủ 3 khóa
# (Console -> API Keys); S3 = Object Storage chuẩn S3 (Vietnix), cần đủ khóa ở mục S3 bên dưới. Có khóa thì
# nơi đó chọn được kể cả khi không phải mặc định. Đổi qua lại không mất ảnh cũ vì DB lưu URL tuyệt đối.
MEDIA_STORAGE_PROVIDER=Local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tayho127
# S3 (Vietnix Object Storage): endpoint, bucket và cặp Access/Secret key lấy ở trang quản lý Object Storage.
# S3_PUBLIC_BASE_URL = URL công khai tới gốc bucket (vd. <endpoint>/<bucket> hoặc domain CDN riêng), KHÔNG có / cuối;
# host của nó phải có trong NEXT_PUBLIC_IMAGE_REMOTE_HOSTS của Frontend. S3_OBJECT_ACL để trống nếu bucket đã
# public bằng bucket policy hoặc nhà cung cấp không nhận ACL.
S3_SERVICE_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FOLDER=tayho127
S3_PUBLIC_BASE_URL=
S3_OBJECT_ACL=public-read

GOOGLE_CLIENT_ID=
