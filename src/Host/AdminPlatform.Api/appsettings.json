{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "AdminPlatform",
    "Audience": "AdminPlatform.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "PhoneVerification": {
    "Required": true,
    "CodeLength": 6,
    "LifetimeMinutes": 5,
    "MaxFailedAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxSendsPerWindow": 5,
    "SendWindowMinutes": 60
  },
  "Esms": {
    "Channel": "Zalo",
    "SmsType": "8",
    "SmsOtpContent": "{code} la ma xac minh dang ky tai khoan cua ban",
    "ZaloOrderPlacedParams": [ "CustomerName", "OrderCode", "TotalAmount" ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "SalesOrders": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "SalesLookup": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "PromotionValidate": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Database": {
    "AutoMigrate": false
  }
}
