{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "AdminPlatform",
    "Audience": "AdminPlatform.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PromotionValidate": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Database": {
    "AutoMigrate": false
  }
}
