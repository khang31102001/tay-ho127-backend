# Copy to .env and fill in real values. Never commit the real .env file (it is gitignored).

# --- Postgres ---
POSTGRES_DB=adminplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API host ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# --- JWT ---
# Generate a real one with: openssl rand -base64 32
JWT_SIGNING_KEY=replace-with-a-real-base64-encoded-32-byte-key
JWT_ISSUER=AdminPlatform
JWT_AUDIENCE=AdminPlatform.Clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- SuperAdmin seed account (used only by `docker compose run migrator`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too
SEED_ADMIN_FULLNAME=Super Admin
