# Copy to .env and fill in real values. Never commit the real .env file (it is gitignored).

# --- Postgres ---
POSTGRES_DB=adminplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API host ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# --- JWT ---
# Generate a real one with: openssl rand -base64 32
JWT_SIGNING_KEY=replace-with-a-real-base64-encoded-32-byte-key
JWT_ISSUER=AdminPlatform
JWT_AUDIENCE=AdminPlatform.Clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- SuperAdmin seed account (used only by `docker compose run migrator`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too
SEED_ADMIN_FULLNAME=Super Admin

# --- Customer Google Sign-In (optional; leave blank to disable) ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials — the `aud` every Google id
# token presented to POST /api/v1/customer/auth/google must match.
GOOGLE_CLIENT_ID=

# --- eSMS (Zalo ZNS + SMS) — secrets only; OA id, brandname and template ids are set in Admin → Tích hợp ---
# Leave blank until you have the keys. The integration cannot be switched on while either is missing.
ESMS_API_KEY=
ESMS_SECRET_KEY=

# --- One-time codes (OTP) ---
# Keys the hash of every code, so a database leak cannot be turned back into codes. Required before any OTP can be
# issued or checked. Generate with: openssl rand -base64 32   (base64, at least 32 bytes). Never reuse the JWT key.
NOTIFICATION_OTP_HMAC_KEY=

# --- Customer sign-up phone verification ---
# false (default): POST /customer/auth/register works as before, no code needed.
# true: a new customer must verify their phone with a one-time code first (POST /customer/auth/register/otp, then register
#       with otpChallengeId + otpCode). Turn it on ONLY after eSMS is enabled in Admin → Tích hợp and the two keys above are
#       set; otherwise nobody can finish registering. Needs NOTIFICATION_OTP_HMAC_KEY.
CUSTOMER_PHONE_VERIFICATION_REQUIRED=false
