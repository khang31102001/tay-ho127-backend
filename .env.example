# Copy to .env and fill in real values. Never commit the real .env file (it is gitignored).

# --- Postgres ---
POSTGRES_DB=adminplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API host ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# --- JWT ---
# Generate a real one with: openssl rand -base64 32
JWT_SIGNING_KEY=replace-with-a-real-base64-encoded-32-byte-key
JWT_ISSUER=AdminPlatform
JWT_AUDIENCE=AdminPlatform.Clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- SuperAdmin seed account (used only by `docker compose run migrator`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too
SEED_ADMIN_FULLNAME=Super Admin

# --- Customer Google Sign-In (optional; leave blank to disable) ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials — the `aud` every Google id
# token presented to POST /api/v1/customer/auth/google must match.
GOOGLE_CLIENT_ID=

# --- Customer phone verification (registration one-time code via eSMS.vn) ---
# API key / secret key come from the eSMS admin portal (NOT the portal login). Leave blank in Development to
# have the code written to the API log instead; in Production a blank key makes registration fail closed.
ESMS_API_KEY=
ESMS_SECRET_KEY=
# Zalo (ZNS) | Sms | ZaloThenSms (SMS when the number has no Zalo)
ESMS_CHANNEL=Zalo
# true = eSMS validates the request but delivers nothing
ESMS_SANDBOX=false
ESMS_ZALO_OA_ID=
# The approved ZNS template whose single parameter is the code
ESMS_ZALO_OTP_TEMPLATE_ID=
# The approved ZNS template for "order placed". Blank = no Zalo message on new orders (log only). Its parameters are
# filled from Esms:ZaloOrderPlacedParams (default: CustomerName, OrderCode, TotalAmount) in the template's order.
ESMS_ZALO_ORDER_PLACED_TEMPLATE_ID=
ESMS_SMS_BRAND_NAME=
ESMS_SMS_TYPE=8
